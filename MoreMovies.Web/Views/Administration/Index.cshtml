@{
    ViewData["Title"] = "Administration";
}

<div class="max-w-6xl mx-auto p-4 md:p-8">
    <h1 class="text-2xl font-bold text-red-500 mb-6">Administration</h1>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <article class="bg-gray-800 rounded-lg shadow p-6 flex flex-col">
            <h2 class="text-xl font-semibold mb-4">Manage Roles</h2>
            <div class="mt-auto">
                <a asp-controller="Administration" asp-action="ListRoles"
                   class="inline-block bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded transition">Manage</a>
            </div>
        </article>

        <article class="bg-gray-800 rounded-lg shadow p-6 flex flex-col">
            <h2 class="text-xl font-semibold mb-4">Manage Users</h2>
            <div class="mt-auto">
                <a asp-controller="Administration" asp-action="All"
                   class="inline-block bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded transition">Manage</a>
            </div>
        </article>

        <article class="bg-gray-800 rounded-lg shadow p-6 flex flex-col">
            <h2 class="text-xl font-semibold mb-4">Add or Delete News</h2>
            <div class="mt-auto flex gap-3">
                <a asp-controller="News" asp-action="Add"
                   class="inline-block bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded transition">Add</a>
                <a asp-controller="Administration" asp-action="EditNews"
                   class="inline-block bg-gray-700 hover:bg-gray-600 text-white px-4 py-2 rounded transition">Edit</a>
            </div>
        </article>

        <article class="bg-gray-800 rounded-lg shadow p-6 flex flex-col">
            <h2 class="text-xl font-semibold mb-4">Add or Delete Coming Soon</h2>
            <div class="mt-auto flex gap-3">
                <a asp-controller="ComingSoon" asp-action="Add"
                   class="inline-block bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded transition">Add</a>
                <a asp-controller="Administration" asp-action="EditComingSoon"
                   class="inline-block bg-gray-700 hover:bg-gray-600 text-white px-4 py-2 rounded transition">Edit</a>
            </div>
        </article>

        <article class="bg-gray-800 rounded-lg shadow p-6 flex flex-col">
            <h2 class="text-xl font-semibold mb-4">Cinema Projections</h2>
            <div class="mt-auto">
                <a asp-controller="Cinema" asp-action="Add"
                   class="inline-block bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded transition">Add</a>
            </div>
        </article>
    </div>
</div>
