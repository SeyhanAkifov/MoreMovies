@model IEnumerable<IdentityRole>

@{
    ViewData["Title"] = "All Roles";
}

<div class="max-w-4xl mx-auto p-4 md:p-8">
    <div class="flex justify-between items-center border-b border-red-600 pb-2 mb-6">
        <h1 class="text-2xl font-bold">All Roles</h1>
        <a asp-controller="Administration" asp-action="CreateRole"
           class="bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded transition">Add new role</a>
    </div>

    @if (Model.Any())
    {
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            @foreach (var role in Model)
            {
                <article class="bg-gray-800 rounded-lg shadow p-4 flex flex-col space-y-2">
                    <p class="text-gray-400 text-sm">Role Id: @role.Id</p>
                    <p class="text-white font-semibold">@role.Name</p>
                    <div class="flex gap-3 mt-auto pt-2">
                        <a asp-controller="Administration" asp-action="EditRoles" asp-route-id="@role.Id"
                           class="bg-gray-700 hover:bg-gray-600 text-white px-3 py-1 rounded transition">Edit</a>
                    </div>
                </article>
            }
        </div>
    }
    else
    {
        <div class="bg-gray-800 rounded-lg shadow p-6 text-center">
            <p class="text-gray-300 mb-4">No roles created yet.</p>
            <a asp-controller="Administration" asp-action="CreateRole"
               class="inline-block bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded transition">Create Role</a>
        </div>
    }
</div>
