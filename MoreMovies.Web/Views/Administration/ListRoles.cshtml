@model IEnumerable<IdentityRole>

@{
    ViewData["Title"] = "All Roles";
}

<div class="max-w-4xl mx-auto p-4 md:p-8">
    <div class="flex flex-wrap justify-between items-center gap-3 pb-4 mb-3">
        <div>
            <h1 class="text-3xl font-bold">Roles</h1>
            <p class="mt-1 text-sm text-gray-300">Manage access and role membership.</p>
        </div>
        <a asp-controller="Administration" asp-action="CreateRole"
           class="cinema-button px-4 py-2 rounded transition">Add new role</a>
    </div>

    @if (Model.Any())
    {
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            @foreach (var role in Model)
            {
                var builtIn = RoleNames.IsBuiltIn(role.Name);
                <article class="bg-gray-800 rounded-xl border border-gray-700 p-4 sm:p-5 flex flex-col gap-3">
                    <div class="flex flex-wrap items-baseline justify-between gap-2">
                        <h2 class="min-w-0 break-all text-lg text-white font-semibold">@role.Name</h2>
                        <span class="text-sm text-gray-300">@(builtIn ? "Built-in role" : "Custom role")</span>
                    </div>
                    <div class="mt-auto">
                        <a asp-controller="Administration" asp-action="EditRoles" asp-route-id="@role.Id"
                           class="inline-flex items-center cinema-button cinema-button-secondary px-3 py-2 rounded">
                            @(builtIn ? "Manage members" : "Edit role")
                        </a>
                    </div>
                </article>
            }
        </div>
    }
    else
    {
        <div class="bg-gray-800 rounded-lg shadow p-6 text-center">
            <p class="text-gray-300 mb-4">No roles created yet.</p>
            <a asp-controller="Administration" asp-action="CreateRole"
               class="inline-block cinema-button px-4 py-2 rounded transition">Create Role</a>
        </div>
    }
</div>
