@model IList<MyProfileViewModel>

@{
    ViewData["Title"] = "All Users";
}

<div class="max-w-4xl mx-auto p-4 md:p-8">
    <h1 class="text-2xl font-bold text-red-500 mb-6">All Users</h1>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        @for (var i = 0; i < Model.Count; i++)
        {
            <article class="bg-gray-800 rounded-lg shadow p-4 flex flex-col space-y-2">
                <p class="text-gray-400 text-sm">User Id: @Model[i].Id</p>
                <p class="text-white font-semibold">@Model[i].Email</p>
                <form asp-controller="Administration" asp-action="DeleteUser" asp-route-id="@Model[i].Id" method="post" class="mt-auto">
                    <button type="submit" class="w-full bg-red-600 hover:bg-red-700 text-white py-2 rounded transition">Delete</button>
                </form>
            </article>
        }
    </div>
</div>
