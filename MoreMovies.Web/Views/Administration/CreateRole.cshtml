@model CreateRoleViewModel

@{
    ViewData["Title"] = "Create New Role";
}

<div class="max-w-xl mx-auto bg-gray-800 rounded-lg shadow-lg p-6 md:p-8">
    <h1 class="text-2xl font-bold text-red-500 mb-6">Create New Role</h1>

    <form asp-controller="Administration" asp-action="CreateRole" method="post" class="space-y-5">
        <div>
            <label asp-for="RoleName" class="block text-sm text-gray-300 mb-1">Role Name</label>
            <input asp-for="RoleName" placeholder="Role Name"
                   class="w-full px-4 py-2 rounded bg-gray-900 border border-gray-700 text-white focus:outline-none focus:ring-2 focus:ring-red-500" />
            <span asp-validation-for="RoleName" class="text-red-400 text-sm"></span>
        </div>

        <button type="submit"
                class="w-full bg-red-600 hover:bg-red-700 text-white py-2 px-4 rounded transition duration-200">
            Create Role
        </button>
    </form>
</div>
