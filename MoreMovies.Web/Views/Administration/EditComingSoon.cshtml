@model ICollection<ComingSoonViewModel>

@{
    ViewData["Title"] = "Manage Coming Soon";
}

<div class="max-w-6xl mx-auto p-4 md:p-8">
    <h1 class="text-2xl font-bold text-red-500 mb-6">Manage Coming Soon</h1>

    @if (Model.Count > 0)
    {
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var item in Model)
            {
                <article class="bg-gray-800 rounded-lg shadow overflow-hidden flex flex-col">
                    <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? Url.Content("~/css/images/movie_placeholder.jpg") : item.ImageUrl)"
                         alt="@item.Title" class="w-full h-48 object-cover">
                    <div class="p-4 flex flex-col flex-grow space-y-2">
                        <h2 class="text-white font-semibold">@item.Title</h2>
                        <p class="text-gray-300 text-sm line-clamp-3 flex-grow">@item.Description</p>
                        <form asp-controller="Administration" asp-action="DeleteComingSoon" asp-route-id="@item.Id" method="post" class="mt-auto">
                            <button type="submit" class="w-full bg-red-600 hover:bg-red-700 text-white py-2 rounded transition">Delete</button>
                        </form>
                    </div>
                </article>
            }
        </div>
    }
    else
    {
        <p class="text-gray-400 text-center py-12">Nothing coming soon yet.</p>
    }
</div>
