@model ICollection<MovieViewModel>

@{
    ViewData["Title"] = "Top Rated Movies";
}

<div class="max-w-7xl mx-auto p-4 md:p-8">
    <div class="flex justify-between items-center border-b border-red-600 pb-2 mb-6">
        <h1 class="text-2xl font-bold">Top Rated Movies</h1>
    </div>

    @if (Model.Count > 0)
    {
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-6">
            @foreach (var movie in Model)
            {
                @await Html.PartialAsync("../Shared/_MoviePR", movie)
            }
        </div>
    }
    else
    {
        <p class="text-gray-400 text-center py-12">No movies here yet.</p>
    }
</div>
