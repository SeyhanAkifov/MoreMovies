@model AddCommentInputModel

@{
    ViewData["Title"] = "Add Comment";
    ViewData["CancelUrl"] = Url.Action("Details", "Movie", new { id = Model.MovieId });
    var movieTitle = ViewBag.MovieTitle as string;
}

<div class="max-w-2xl mx-auto bg-gray-800 rounded-lg shadow-lg p-6 md:p-8">
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-red-500">Add Comment</h1>
        @if (!string.IsNullOrEmpty(movieTitle))
        {
            <p class="text-gray-400 mt-1">for <span class="text-gray-200">@movieTitle</span></p>
        }
    </div>

    <partial name="_CommentForm" model="Model" view-data="ViewData" />
</div>
