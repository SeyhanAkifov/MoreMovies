@model ICollection<NewsViewModel>

@{
    ViewData["Title"] = "All News";
}

<div class="max-w-7xl mx-auto p-4 md:p-8">
    <div class="flex justify-between items-center border-b border-red-600 pb-2 mb-6">
        <h1 class="text-2xl font-bold">All News</h1>
    </div>

    @if (Model.Count > 0)
    {
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var item in Model)
            {
                @await Html.PartialAsync("News", item)
            }
        </div>
    }
    else
    {
        <p class="text-gray-400 text-center py-12">No news yet.</p>
    }
</div>
