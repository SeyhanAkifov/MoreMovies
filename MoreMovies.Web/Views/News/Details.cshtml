@model NewsViewModel

@{
    ViewData["Title"] = Model?.Title ?? "News";
}

@if (Model != null)
{
    <div class="max-w-3xl mx-auto bg-gray-800 rounded-lg shadow-lg p-6 md:p-8">
        <p class="text-gray-400 text-sm mb-2">@Model.AddedOn</p>
        <h1 class="text-3xl font-bold text-red-500 mb-4">@Model.Title</h1>
        <hr class="border-gray-700 mb-4" />
        <p class="text-gray-200 whitespace-pre-line">@Model.Description</p>
    </div>
}
else
{
    <h1 class="text-2xl text-red-500 font-bold text-center mt-8">News Not Found</h1>
}
