@model CinemaProjectionInputDto

@{
    ViewData["Title"] = "Add Projection";
}

<div class="max-w-2xl mx-auto bg-gray-800 rounded-lg shadow-lg p-6 md:p-8">
    <h1 class="text-2xl font-bold text-red-500 mb-6">Add Projection</h1>

    <form asp-controller="Cinema" asp-action="Add" method="post" class="space-y-5">
        <div>
            <label asp-for="ProjectionTime" class="block text-sm text-gray-300 mb-1">Date</label>
            <input asp-for="ProjectionTime" type="date"
                   class="w-full px-4 py-2 rounded bg-gray-900 border border-gray-700 text-white focus:outline-none focus:ring-2 focus:ring-red-500" />
            <span asp-validation-for="ProjectionTime" class="text-red-400 text-sm"></span>
        </div>

        <div>
            <label asp-for="CinemaName" class="block text-sm text-gray-300 mb-1">Cinema</label>
            <select asp-for="CinemaName"
                    class="w-full px-4 py-2 rounded bg-gray-900 border border-gray-700 text-white focus:outline-none focus:ring-2 focus:ring-red-500">
                @foreach (var item in ViewBag.Names)
                {
                    <option>@item</option>
                }
            </select>
            <span asp-validation-for="CinemaName" class="text-red-400 text-sm"></span>
        </div>

        <div>
            <label asp-for="MovieName" class="block text-sm text-gray-300 mb-1">Movie Name</label>
            <input asp-for="MovieName" placeholder="Movie Name"
                   class="w-full px-4 py-2 rounded bg-gray-900 border border-gray-700 text-white focus:outline-none focus:ring-2 focus:ring-red-500" />
            <span asp-validation-for="MovieName" class="text-red-400 text-sm"></span>
        </div>

        <div>
            <label asp-for="CinemaHallName" class="block text-sm text-gray-300 mb-1">Hall</label>
            <input asp-for="CinemaHallName" placeholder="Hall Name"
                   class="w-full px-4 py-2 rounded bg-gray-900 border border-gray-700 text-white focus:outline-none focus:ring-2 focus:ring-red-500" />
            <span asp-validation-for="CinemaHallName" class="text-red-400 text-sm"></span>
        </div>

        <div>
            <label asp-for="Time" class="block text-sm text-gray-300 mb-1">Time</label>
            <input asp-for="Time" placeholder="Time"
                   class="w-full px-4 py-2 rounded bg-gray-900 border border-gray-700 text-white focus:outline-none focus:ring-2 focus:ring-red-500" />
            <span asp-validation-for="Time" class="text-red-400 text-sm"></span>
        </div>

        <button type="submit"
                class="w-full bg-red-600 hover:bg-red-700 text-white py-2 px-4 rounded transition duration-200">
            Add
        </button>
    </form>
</div>
