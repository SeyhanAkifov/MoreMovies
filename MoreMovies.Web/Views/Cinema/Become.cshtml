@model CinemaInputDto

@{
    ViewData["Title"] = "Become a Cinema Manager";
}

<div class="max-w-xl mx-auto bg-gray-800 rounded-lg shadow-lg p-6 md:p-8">
    <h1 class="text-2xl font-bold text-red-500 mb-2">Become a Cinema Manager</h1>
    <p class="text-gray-400 mb-6">As a Cinema Manager you can add cinema projections and edit them.</p>

    <form asp-controller="Cinema" asp-action="AddCinema" method="post" class="space-y-5">
        <div>
            <label asp-for="CinemaName" class="block text-sm text-gray-300 mb-1">Cinema Name</label>
            <input asp-for="CinemaName" placeholder="Cinema Name"
                   class="w-full px-4 py-2 rounded bg-gray-900 border border-gray-700 text-white focus:outline-none focus:ring-2 focus:ring-red-500" />
            <span asp-validation-for="CinemaName" class="text-red-400 text-sm"></span>
        </div>

        <button type="submit"
                class="w-full bg-red-600 hover:bg-red-700 text-white py-2 px-4 rounded transition duration-200">
            Add
        </button>
    </form>
</div>
