@model InCinemaViewModel

@{
    ViewData["Title"] = "In Cinema";
}

<div class="max-w-6xl mx-auto p-4 md:p-8 space-y-6">
    <section class="bg-gray-800 p-6 rounded-lg shadow-md">
        <form asp-controller="Cinema" asp-action="InCinema" method="get" class="flex flex-col sm:flex-row gap-3">
            <select name="cinemaName"
                    class="flex-1 px-4 py-2 rounded bg-gray-900 border border-gray-700 text-white focus:outline-none focus:ring-2 focus:ring-red-500">
                @foreach (var item in Model.CinemaNames)
                {
                    <option value="@item">@item</option>
                }
            </select>
            <button type="submit" class="bg-red-600 hover:bg-red-700 text-white px-6 py-2 rounded transition">Go</button>
        </form>
    </section>

    <h1 class="text-2xl font-bold text-red-500">Projections in @ViewBag.Name</h1>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        @for (int i = 0; i < 7; i++)
        {
            var day = DateTime.UtcNow.AddDays(i);
            var projectionsForDay = Model.Projections.Where(x => x.ProjectionTime.Date == day.Date).ToList();

            <article class="bg-gray-800 rounded-lg shadow p-4 space-y-3">
                <h2 class="text-lg font-semibold border-b border-gray-700 pb-2">@day.DayOfWeek</h2>

                @if (projectionsForDay.Any())
                {
                    @foreach (var item in projectionsForDay)
                    {
                        <div class="bg-gray-900 rounded p-3">
                            <p class="text-white font-medium">@item.MovieName</p>
                            <p class="text-gray-400 text-sm">Hall: @item.CinemaHall</p>
                            <p class="text-gray-400 text-sm">@item.Time</p>
                        </div>
                    }
                }
                else
                {
                    <p class="text-gray-500 text-sm">No projections found.</p>
                }
            </article>
        }
    </div>
</div>
