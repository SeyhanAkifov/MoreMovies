@if (User.Identity?.IsAuthenticated == true)
{
    var name = string.IsNullOrWhiteSpace(User.Identity.Name) ? "Account" : User.Identity.Name;

    <details class="site-account">
        <summary>
            <span class="site-avatar" aria-hidden="true">@name[..1].ToUpperInvariant()</span>
            Account
        </summary>
        <div class="site-account-panel">
            <p>@name</p>
            <a asp-area="" asp-controller="Movie" asp-action="MyMovies">My movies</a>
            <a asp-area="" asp-controller="Movie" asp-action="MyLiked">Liked movies</a>
            <a asp-area="" asp-controller="Movie" asp-action="Add">Add movie</a>
            @if (User.IsInRole(RoleNames.Manager))
            {
                <a asp-area="" asp-controller="Cinema" asp-action="Add">Add projection</a>
            }
            else
            {
                <a asp-area="" asp-controller="Cinema" asp-action="Become">Become a cinema agent</a>
            }
            @if (User.IsInRole(RoleNames.Admin))
            {
                <a asp-area="" asp-controller="Administration" asp-action="Index">Administration</a>
            }
            <form asp-area="" asp-controller="Home" asp-action="Logout" method="post">
                <button type="submit">Sign out</button>
            </form>
        </div>
    </details>
}
else
{
    <div class="site-auth-links">
        <a asp-area="" asp-controller="Home" asp-action="Register">Register</a>
        <a class="site-sign-in" asp-area="Identity" asp-page="/Account/Login">Sign in</a>
    </div>
}
