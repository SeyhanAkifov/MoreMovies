@model MovieViewModel

@{
    var poster = string.IsNullOrEmpty(Model.ImageUrl)
        ? Url.Content("~/css/images/movie_placeholder.jpg")
        : Model.ImageUrl;
    var rating = Model.RatingCount > 0
        ? ((double)Model.Rating / Model.RatingCount).ToString("0.0")
        : null;
}

<article class="catalog-card">
    @if (!string.IsNullOrWhiteSpace(Model.HomePage))
    {
        <button type="button" class="catalog-poster" data-trailer="@Model.HomePage"
                aria-label="Play trailer for @Model.Title">
            <img src="@poster" alt="" loading="lazy" decoding="async" />
            <span>Play trailer</span>
        </button>
    }
    else
    {
        <div class="catalog-poster">
            <img src="@poster" alt="" loading="lazy" decoding="async" />
        </div>
    }

    <div class="catalog-card-copy">
        <h3>
            <a asp-controller="Movie" asp-action="Details" asp-route-id="@Model.Id">@Model.Title</a>
        </h3>
        @if (rating is not null)
        {
            <p class="catalog-rating">Rated @rating / 5</p>
        }
        <p>@Model.Likes likes · @Model.CommentsCount comments</p>
    </div>
</article>
