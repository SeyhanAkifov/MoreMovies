<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MoreMovies</title>

    <!-- Tailwind CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
</head>
<body class="text-gray-100 flex flex-col min-h-screen">
    <div class="relative z-10 flex flex-col min-h-screen">
        <header class="site-header">
            <div class="site-header-inner">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="site-brand">
                    <img src="~/css/images/logo2.png" alt="" width="32" height="32" />
                    MoreMovies
                </a>
                <button class="site-nav-toggle" type="button" aria-controls="site-navigation"
                        aria-expanded="false" hidden>Menu</button>
                <nav id="site-navigation" class="site-navigation" aria-label="Main navigation">
                    <div class="site-nav-links">
                        <a asp-area="" asp-controller="Movie" asp-action="All"
                           aria-current="@(ViewContext.RouteData.Values["controller"] as string == "Movie" ? "page" : null)">Movies</a>
                        <a asp-area="" asp-controller="Cinema" asp-action="InCinema"
                           aria-current="@(ViewContext.RouteData.Values["controller"] as string == "Cinema" ? "page" : null)">In Cinema</a>
                        <a asp-area="" asp-controller="ComingSoon" asp-action="All"
                           aria-current="@(ViewContext.RouteData.Values["controller"] as string == "ComingSoon" ? "page" : null)">Coming Soon</a>
                        <a asp-area="" asp-controller="News" asp-action="All"
                           aria-current="@(ViewContext.RouteData.Values["controller"] as string == "News" ? "page" : null)">News</a>
                        <a asp-area="" asp-controller="Contact" asp-action="ContactPage"
                           aria-current="@(ViewContext.RouteData.Values["controller"] as string == "Contact" ? "page" : null)">Contact</a>
                    </div>
                    <partial name="_LoginPartial" />
                </nav>
            </div>
        </header>

        <!-- Main Content -->
        <main class="flex-grow w-full max-w-7xl mx-auto px-4 py-6">
            @RenderBody()
        </main>

        <!-- Footer -->
        <footer class="site-footer">
            &copy; @DateTime.UtcNow.Year - MoreMovies - Seyhan Akifov
        </footer>

        <dialog id="trailerModal" aria-label="Movie trailer">
            <form method="dialog">
                <button type="submit" class="trailer-close" aria-label="Close trailer">&times;</button>
            </form>
            <iframe id="trailerFrame" title="Movie trailer"
                    allow="autoplay; encrypted-media" allowfullscreen></iframe>
        </dialog>

        <!-- Scripts -->
        <script src="~/lib/signalr/dist/browser/signalr.min.js"></script>
        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        <partial name="_ValidationScriptsPartial" />
        <script src="~/js/site.js" asp-append-version="true"></script>
        @await RenderSectionAsync("Scripts", required: false)
    </div>
</body>
</html>
